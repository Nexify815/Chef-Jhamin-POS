# ==================== LOCAL DEVELOPMENT (SQLite) ====================
# No DATABASE_URL needed! The app auto-detects SQLite when DATABASE_URL is absent.
# Just create a .env file with at minimum:

SECRET_KEY=change-this-to-a-long-random-string
PORT=3000

# Then run:  npm start
# Data is saved to kitchen.db (auto-created).

# ==================== PRODUCTION (PostgreSQL) ====================
# Set DATABASE_URL to enable PostgreSQL (required for Render deployment).

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Secret (REQUIRED - change to a long random string)
SECRET_KEY=change-this-to-a-long-random-string

# Server Port
PORT=3000

# Environment
NODE_ENV=production

# CORS - Comma-separated list of allowed origins (leave empty for localhost defaults)
# Example: CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=
